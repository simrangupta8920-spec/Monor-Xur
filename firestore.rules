rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Evaluates if caller is the assigned caregiver, assigned ASHA, or explicitly authorized user for this patient
    function isAssignedCaregiverOrAsha(patientData) {
      return isAuthenticated() && (
        request.auth.uid == patientData.assignedCaregiverUid ||
        request.auth.uid == patientData.assignedAshaUid ||
        (patientData.authorizedUids is list && request.auth.uid in patientData.authorizedUids) ||
        (patientData.caregiver != null && (
          (patientData.caregiver.uid != null && request.auth.uid == patientData.caregiver.uid) ||
          (request.auth.token.phone != null && request.auth.token.phone == patientData.caregiver.phone)
        )) ||
        (patientData.asha != null && (
          (patientData.asha.uid != null && request.auth.uid == patientData.asha.uid) ||
          (request.auth.token.workerId != null && request.auth.token.workerId == patientData.asha.workerId)
        ))
      );
    }

    function canAccessPatient(patientId) {
      return isAssignedCaregiverOrAsha(get(/databases/$(database)/documents/patients/$(patientId)).data);
    }

    // Patients collection - scoped to assigned caregiver/ASHA
    match /patients/{patientId} {
      // Allow initial onboarding creation if authenticated
      allow create: if isAuthenticated() && isValidId(patientId) 
        && request.resource.data.name is string 
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      // Scoped read and update: only assigned caregiver or ASHA
      allow get: if isValidId(patientId) && isAssignedCaregiverOrAsha(resource.data);
      allow list: if isAuthenticated();
      allow update: if isValidId(patientId) && isAssignedCaregiverOrAsha(resource.data);
      allow delete: if isValidId(patientId) && isAssignedCaregiverOrAsha(resource.data);

      // Medical profile subcollection
      match /medical/{medicalId} {
        allow read, write: if isValidId(patientId) && isValidId(medicalId) && canAccessPatient(patientId);
      }

      // Memories subcollection
      match /memories/{memoryId} {
        allow read: if isValidId(patientId) && isValidId(memoryId) && canAccessPatient(patientId);
        allow create, update: if isValidId(patientId) && isValidId(memoryId) && canAccessPatient(patientId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200;
        allow delete: if isValidId(patientId) && isValidId(memoryId) && canAccessPatient(patientId);
      }

      // Reminders subcollection
      match /reminders/{reminderId} {
        allow read: if isValidId(patientId) && isValidId(reminderId) && canAccessPatient(patientId);
        allow create, update: if isValidId(patientId) && isValidId(reminderId) && canAccessPatient(patientId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200;
        allow delete: if isValidId(patientId) && isValidId(reminderId) && canAccessPatient(patientId);
      }

      // Calendar Events subcollection
      match /events/{eventId} {
        allow read: if isValidId(patientId) && isValidId(eventId) && canAccessPatient(patientId);
        allow create, update: if isValidId(patientId) && isValidId(eventId) && canAccessPatient(patientId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200;
        allow delete: if isValidId(patientId) && isValidId(eventId) && canAccessPatient(patientId);
      }

      // Care Tasks subcollection
      match /care_tasks/{taskId} {
        allow read, write: if isValidId(patientId) && isValidId(taskId) && canAccessPatient(patientId);
      }

      // Alerts subcollection
      match /alerts/{alertId} {
        allow read, write: if isValidId(patientId) && isValidId(alertId) && canAccessPatient(patientId);
      }

      // Contacts subcollection
      match /contacts/{contactId} {
        allow read, write: if isValidId(patientId) && isValidId(contactId) && canAccessPatient(patientId);
      }

      // DDA Logs subcollection
      match /dda_logs/{logId} {
        allow read, write: if isValidId(patientId) && isValidId(logId) && canAccessPatient(patientId);
      }

      // Audit Logs subcollection (DPDP Act 2023 compliance audit trail)
      // Append-only for assigned caregiver/ASHA, immutable (updates and deletes strictly forbidden)
      match /auditLogs/{logId} {
        allow read: if isValidId(patientId) && isValidId(logId) && canAccessPatient(patientId);
        allow create: if isValidId(patientId) && isValidId(logId) && canAccessPatient(patientId);
        allow update, delete: if false;
      }
    }
  }
}
